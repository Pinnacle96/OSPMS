APP_NAME="Osun State Park Management System"
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_NG
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ospm
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

MAIL_MAILER=array
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="support@demo.local"
MAIL_FROM_NAME="${APP_NAME}"

OSPM_DEMO_MODE=true
PAYMENT_MODE=demo
PAYMENT_PROVIDER=demo
DEMO_DEFAULT_PASSWORD=
OSPM_CURRENCY=NGN
OSPM_TIMEZONE=Africa/Lagos
OSPM_REFERENCE_PREFIX=OSPM
OSPM_TICKET_EXPIRY_MINUTES=
OSPM_BRAND_PRIMARY="#142a43"
OSPM_BRAND_PRIMARY_DARK="#102237"
OSPM_BRAND_SECONDARY="#235e91"
OSPM_GOVERNMENT_LOGO=
OSPM_POWERED_BY="Technology Solution by Pinnacle Tech Hub"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false
